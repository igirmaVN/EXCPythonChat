import tkinter as tk

def hello():
    name = entry.get()
    label_result.config(text=f"Привет, {name}!")

# Создаем окно
window = tk.Tk()
window.title("(ЕХС) Chat with AI")
window.geometry("350x220")

# Надпись
label = tk.Label(window, text="Введите ваш запрос:")
label.pack(pady=10)

# Поле ввода
entry = tk.Entry(window, width=30)
entry.pack(pady=5)

# Кнопка
button = tk.Button(
    window,
    text="Поздороваться",
    command=hello
)
button.pack(pady=10)

# Результат
label_result = tk.Label(window, text="")
label_result.pack(pady=10)

# Запускаем окно
window.mainloop()
